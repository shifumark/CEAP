{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  // Test files import vitest, a devDependency Render's production
  // install (NODE_ENV=production) doesn't install — compiling them into
  // the production build breaks `tsc` there even though it works locally.
  // They're also never meant to ship in dist/ in the first place.
  "exclude": ["src/**/*.test.ts"]
}