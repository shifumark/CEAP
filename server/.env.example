# Copy this file to server/.env and fill in real values.
# dotenv.config() (server/src/index.ts) and the Prisma CLI both read
# server/.env — not the .env.example at the repo root.

NODE_ENV=development
PORT=4000

# JWT signing secret. REQUIRED — the server refuses to start without a
# real value at least 16 characters long (see server/src/lib/env.ts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the same secret across environments, and never commit the
# real value — this file only holds a placeholder.
JWT_SECRET=replace-with-output-of-the-command-above

# Frontend origin allowed by CORS (GitHub Pages URL in production).
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres connection strings.
# DATABASE_URL: pooled connection (port 6543, via PgBouncer) — used at runtime.
# DIRECT_URL:   direct connection (port 5432) — used by `prisma migrate`.
# Both are on the Supabase project dashboard under Project Settings > Database.
#
# connection_limit is set explicitly rather than left to Prisma's default
# (num_physical_cpus * 2 + 1) — that default is a guess Prisma makes about
# your Render instance's CPU count, not something tuned to what Supabase's
# PgBouncer pool on the other end can actually sustain. 10 is a reasonable
# starting point for a small/starter instance; raise it if you upgrade the
# Render plan and see connection-pool-exhaustion errors under real load,
# but stay under whatever Supabase's own pooler limit is for your plan.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Storage (legacy — kept only as a fallback so documents uploaded
# before the Google Drive switch remain downloadable).
# Service role key is server-side only — never expose it to the client.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive (current document storage). Service accounts can't write to
# a personal Google account's Drive (no storage quota of their own), so
# this uses standard OAuth 2.0 with a long-lived refresh token acting as
# the account that completed the one-time consent flow. drive.file scope
# only — the app can only see files it created itself, never the rest of
# the Drive. The OAuth consent screen must be "In production" (not
# "Testing"), or the refresh token expires after 7 days.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Optional second Drive account for overflow storage (see
# lib/googleDrive.ts) — uploads use this account once the first one
# (GOOGLE_REFRESH_TOKEN) runs low on space, checked by real quota at
# upload time. GOOGLE_CLIENT_ID/SECRET above are reused as-is (same OAuth
# app, just a different consenting Google account); only the refresh
# token and folder differ. Leave both unset to run with a single account.
# GOOGLE_REFRESH_TOKEN_2=your-second-account-refresh-token
# GOOGLE_DRIVE_FOLDER_ID_2=your-second-account-drive-folder-id

# Email notifications (application status updates, new program
# announcements) via Gmail SMTP. Optional — if unset, EmailService no-ops
# instead of crashing the server. EMAIL_APP_PASSWORD is a 16-character
# Google App Password (Google Account > Security > 2-Step Verification >
# App Passwords), not the account's real password.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
